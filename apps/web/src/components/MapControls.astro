---
/** Zoom controls (DESIGN.md §4.17: bottom-right stack, 32 px, --bg, card shadow, radius 6). JS only. */
import type { Lang } from '../i18n/index.ts';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = lang === 'hi' ? { in: 'ज़ूम इन', out: 'ज़ूम आउट', reset: 'पूरा नक्शा' } : { in: 'Zoom in', out: 'Zoom out', reset: 'Show the whole map' };
---
<div class="absolute right-3 bottom-3 flex flex-col gap-1.5 z-[5]" data-js-only hidden>
  <button type="button" class="map-ctl" data-zoom-btn="in" aria-label={L.in} title={L.in}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
  </button>
  <button type="button" class="map-ctl" data-zoom-btn="out" aria-label={L.out} title={L.out}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14" /></svg>
  </button>
  <button type="button" class="map-ctl map-ctl-reset" data-zoom-btn="reset" aria-label={L.reset} title={L.reset}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
  </button>
</div>
