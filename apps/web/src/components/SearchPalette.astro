---
/**
 * Search palette (DESIGN.md §4.14). Native <dialog>: focus trap, Esc and a11y
 * for free. Cities are embedded (instant); stations and other CPCB cities
 * load from /api/search.json the first time it opens. Without JS the nav
 * field is a plain form that redirects via /search.
 */
import { t, localePath, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
  index: { s: string; en: string; hi: string; st: string; a: string[]; q: number | null; u: number | null }[];
}
const { lang, index } = Astro.props;
const d = t(lang);
const hi = lang === 'hi';
const L = {
  cities: hi ? 'शहर' : 'Cities',
  stations: hi ? 'स्टेशन और इलाके' : 'Stations & areas',
  others: hi ? 'दूसरे शहर (नक्शे पर)' : 'Other cities (on the map)',
  popular: hi ? 'लोकप्रिय शहर' : 'Popular cities',
  recent: hi ? 'हाल में देखे' : 'Recent',
  locate: d.near.use,
  locateSub: hi ? 'सबसे पास का स्टेशन, आपके फ़ोन पर ही' : 'Nearest station, worked out on your phone',
  none: hi ? 'कोई नतीजा नहीं। शहर का नाम हिंदी या अंग्रेज़ी में लिखें।' : 'No match. Try a city name in English or Hindi.',
  near: hi ? 'पास का शहर' : 'near',
  map: hi ? 'नक्शे पर देखें' : 'on the map',
  keys: hi ? '↑↓ चुनें · ↵ खोलें · esc बंद' : '↑↓ to move · ↵ to open · esc to close',
  home: localePath(lang, '/'),
  base: localePath(lang, '/aqi/'),
};
---
<dialog
  id="search-palette"
  class="palette m-0 w-full max-w-none h-dvh max-h-none sm:m-auto sm:mt-[10vh] sm:w-[600px] sm:h-fit sm:max-h-[76vh] p-0 text-[var(--color-fg)] overflow-hidden"
  aria-label={d.nav.search}
  data-lang={lang}
>
  <div class="flex flex-col h-full sm:max-h-[76vh]">
    <form method="get" action={localePath(lang, '/search')} class="flex items-center gap-3 px-4 h-14 shrink-0 hairline-b" data-palette-form>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-fg-subtle)] shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
      <label for="palette-q" class="sr-only">{d.nav.search}</label>
      <input id="palette-q" name="q" class="flex-1 min-w-0 bg-transparent outline-none text-[17px] placeholder:text-[var(--color-fg-subtle)]" placeholder={d.nav.search} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list" />
      <button type="button" class="kbd cursor-pointer hover:bg-[var(--color-bg-muted)]" data-palette-close aria-label="Close">Esc</button>
    </form>
    <div id="palette-results" role="listbox" class="flex-1 overflow-y-auto overscroll-contain px-2 py-2" data-palette-results></div>
    <p class="hidden sm:block shrink-0 hairline-t px-4 py-2 font-mono text-[11px] text-[var(--color-fg-subtle)]">{L.keys}</p>
  </div>
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
  <script type="application/json" data-search-text set:html={JSON.stringify(L)} />
</dialog>
