---
import { t, localePath, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
  index: { s: string; en: string; hi: string; st: string; a: string[]; q: number | null; u: number | null }[];
}
const { lang, index } = Astro.props;
const d = t(lang);
---
{/* Native <dialog>: focus trap, Esc and a11y for free (DESIGN.md §4.14). */}
<dialog
  id="search-palette"
  class="raised m-0 w-full max-w-none h-dvh max-h-none sm:m-auto sm:mt-[12vh] sm:w-[560px] sm:h-auto sm:max-h-[70vh] p-0 backdrop:bg-black/40 text-[var(--color-fg)]"
  aria-label={d.nav.search}
  data-lang={lang}
  data-base={localePath(lang, '/aqi/')}
>
  <form method="get" action={localePath(lang, '/search')} class="p-3 hairline-b flex items-center gap-2" data-palette-form>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-fg-subtle)] shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <label for="palette-q" class="sr-only">{d.nav.search}</label>
    <input id="palette-q" name="q" class="input bg-transparent! shadow-none! px-1" placeholder={d.nav.search} autocomplete="off" role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list" />
    <button type="button" class="btn btn-ghost px-2! t-small" data-palette-close aria-label="Close"><kbd class="kbd">Esc</kbd></button>
  </form>
  <ul id="palette-results" role="listbox" class="overflow-y-auto max-h-[calc(100dvh-80px)] sm:max-h-[52vh] p-2" data-palette-results></ul>
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</dialog>
