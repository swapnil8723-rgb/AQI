---
import { CPCB_HEALTH, VERDICTS, type VerdictLevel, type VerdictRow } from '@saans/data';
import type { NaqiCategory } from '@saans/aqi';
import { t, localePath, type Lang } from '../i18n/index.ts';
import { CATEGORY_LABEL } from '../lib/aqi-ui.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  category: NaqiCategory | null;
  bulletinUrl?: string;
}
const { lang, category, bulletinUrl } = Astro.props;
const d = t(lang);
// Verdict colour follows the verdict's own severity (DESIGN.md §4.5).
const INK: Record<VerdictLevel, string> = { ok: 'good', caution: 'poor', avoid: 'verypoor' };
const ROWS: { key: VerdictRow; label: string; icon: string }[] = [
  { key: 'run', label: d.verdict.run, icon: 'footprints' },
  { key: 'kids', label: d.verdict.kids, icon: 'baby' },
  { key: 'windows', label: d.verdict.windows, icon: 'app-window' },
  { key: 'mask', label: d.verdict.mask, icon: 'shield' },
];
---
<section class="card p-5 h-full" aria-labelledby="verdict-title">
  <h2 id="verdict-title" class="t-h3">{d.verdict.title}</h2>
  {category ? (
    <>
      <ul class="mt-3">
        {ROWS.map((r) => {
          const v = VERDICTS[category][r.key];
          return (
            <li class="flex items-center gap-3 min-h-12 hairline-b last:shadow-none">
              <Icon name={r.icon} class="text-[var(--color-fg-muted)] shrink-0" />
              <span class="flex-1 t-small">{r.label}</span>
              <span class="t-small font-semibold text-right" data-aqi={INK[v.level]} style="color:var(--aqi-ink)">{v[lang]}</span>
            </li>
          );
        })}
      </ul>
      <p class="t-small text-[var(--color-fg-subtle)] mt-3">
        {d.verdict.basis(CATEGORY_LABEL[category][lang])} {CPCB_HEALTH[category][lang]}.{' '}
        {bulletinUrl && <a href={bulletinUrl} class="underline" target="_blank" rel="noopener">CPCB ↗</a>}{' '}
        {d.verdict.notMedical} <a href={`${localePath(lang, '/about')}#methodology`} class="underline">{d.source.methodology}</a>
      </p>
    </>
  ) : (
    <p class="t-small text-[var(--color-fg-muted)] mt-3">{d.insufficient}</p>
  )}
</section>
