---
/**
 * "Share today's air" (PLAN.md §5.2 item 10, DESIGN.md §4.11). Opens the
 * share sheet (ShareSheet.astro). Tinted with the city's air colour rather
 * than a black primary button.
 */
import { t, type Lang } from '../i18n/index.ts';
import type { SlotName } from '../lib/aqi-ui.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  slot: SlotName;
  class?: string;
}
const { lang, slot, class: cls = '' } = Astro.props;
const d = t(lang);
---
<button type="button" class={`btn btn-tint ${cls}`} data-aqi={slot} data-share-open>
  <Icon name="share-2" size={16} />
  {d.share.button}
</button>
