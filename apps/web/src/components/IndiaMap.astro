---
/**
 * Home map (DESIGN.md §4.16, PLAN.md §5.3 A): India's official boundary,
 * pre-projected at build time (0 KB map JS). Launch cities are <a> links;
 * every other CPCB city is a small context dot. Delhi-NCR sits in a 4× inset
 * so its six neighbouring cities stay tappable.
 */
import { CITIES } from '@saans/data';
import { t, localePath, type Lang } from '../i18n/index.ts';
import { CATEGORY_LABEL, NAQI_ROWS, US_ROWS, US_LABEL, catLabel, slotN, slotU } from '../lib/aqi-ui.ts';
import MapCardLabels from './MapCardLabels.astro';
import { relative } from '../lib/format.ts';
import { INDIA, projectIndia, projectNcr, r1 } from '../lib/map.ts';
import type { Bundle } from '../lib/bundle.ts';

interface Props {
  lang: Lang;
  bundle: Bundle | null;
}
const { lang, bundle } = Astro.props;
const d = t(lang);
const W = INDIA.width;
const H = INDIA.height;
// Inset: a 4× circle over Tibet, just north-east of Delhi and clear of India's
// boundary, so the leader line is short (DESIGN.md §4.16: 120 px).
const INSET = { cx: 332, cy: 84, r: 52 };
const s = INSET.r / INDIA.ncr.r;
const [delhiX, delhiY] = projectIndia(28.62, 77.2);
const lead = (() => {
  const dx = delhiX - INSET.cx;
  const dy = delhiY - INSET.cy;
  const len = Math.hypot(dx, dy);
  return { x: r1(INSET.cx + (dx / len) * INSET.r), y: r1(INSET.cy + (dy / len) * INSET.r) };
})();

const launch = CITIES.filter((c) => c.live).map((c) => {
  const now = bundle?.cities[c.slug]?.now ?? null;
  const [x, y] = c.ncr ? projectNcr(c.lat, c.lon) : projectIndia(c.lat, c.lon);
  const n = now?.total ?? 1;
  return {
    c, now, x: r1(c.ncr ? INSET.cx - INSET.r + x * s : x), y: r1(c.ncr ? INSET.cy - INSET.r + y * s : y),
    r: r1(6 + 6 * Math.min(1, Math.log(Math.max(1, n)) / Math.log(40))),
  };
});
const launchNames = new Set(CITIES.map((c) => c.feed.city.toLowerCase()));
const context = (bundle?.map ?? [])
  .filter((m) => m.slug === null && m.aqi !== null && !launchNames.has(m.name.toLowerCase()))
  .map((m) => {
    const [x, y] = projectIndia(m.lat, m.lon);
    return { m, x: r1(x), y: r1(y) };
  })
  .sort((a, b) => (a.m.aqi ?? 0) - (b.m.aqi ?? 0));
/** The 8 largest cities are labelled; the side keeps labels off their neighbours. */
const LABELS: Record<string, 'l' | 'r'> = { mumbai: 'l', bengaluru: 'l', ahmedabad: 'l', jaipur: 'l', kolkata: 'r', chennai: 'r', hyderabad: 'r', lucknow: 'r' };
const name = (c: (typeof CITIES)[number]) => (lang === 'hi' ? c.hi : c.en);
---
<figure class="relative">
  <div class="relative rounded-[12px] bg-[var(--color-bg-subtle)] ring-1px p-2 sm:p-4" data-map>
    <svg viewBox={`0 0 ${W} ${H}`} class="block w-full h-auto" role="group" aria-label={d.home.map}>
      <path d={INDIA.outline} fill="var(--color-bg)" stroke="var(--color-fg-subtle)" stroke-width="1" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
      <path d={INDIA.borders} fill="none" stroke="var(--color-ring-strong)" stroke-width="0.5" vector-effect="non-scaling-stroke" />
      <g aria-hidden="true">
        {context.map(({ m, x, y }) => (
          <circle cx={x} cy={y} r="3" data-aqi={slotN(m.aqi)} class="ctx-dot">
            <title>{m.name}: {m.aqi}</title>
          </circle>
        ))}
        {/* NCR cities on the main map: markers only; the links live in the inset. */}
        {CITIES.filter((c) => c.live && c.ncr).map((c) => {
          const [x, y] = projectIndia(c.lat, c.lon);
          const now = bundle?.cities[c.slug]?.now;
          return <circle cx={r1(x)} cy={r1(y)} r="3.5" data-aqi={slotN(now?.aqi)} data-aqi-us={slotU(now?.us)} class="map-dot thin" />;
        })}
        <line x1={delhiX} y1={delhiY} x2={lead.x} y2={lead.y} stroke="var(--color-fg-subtle)" stroke-width="0.75" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
      </g>
      <defs><clipPath id="ncr-clip"><circle cx={INSET.cx} cy={INSET.cy} r={INSET.r} /></clipPath></defs>
      <g clip-path="url(#ncr-clip)" aria-hidden="true">
        <circle cx={INSET.cx} cy={INSET.cy} r={INSET.r} fill="var(--color-bg-subtle)" />
        <g transform={`translate(${INSET.cx - INSET.r} ${INSET.cy - INSET.r}) scale(${s})`}>
          <path d={INDIA.ncr.outline} fill="var(--color-bg)" />
          <path d={INDIA.ncr.borders} fill="none" stroke="var(--color-ring-strong)" stroke-width="1" vector-effect="non-scaling-stroke" />
        </g>
      </g>
      <circle cx={INSET.cx} cy={INSET.cy} r={INSET.r} fill="none" stroke="var(--color-fg-subtle)" stroke-width="1" vector-effect="non-scaling-stroke" aria-hidden="true" />
      {launch.map(({ c, now, x, y, r }) => (
        <a href={localePath(lang, `/aqi/${c.slug}`)} data-card data-n={name(c)} data-v={now?.aqi ?? ''} data-u={now?.us ?? ''} data-s={now ? `${d.hero.live} · ${relative(now.at, lang)}` : ''} aria-label={`${name(c)}, AQI ${now ? `${now.aqi}, ${catLabel(now.aqi, lang)}` : d.insufficient}`}>
          <circle cx={x} cy={y} r={c.ncr ? 16 : 22} fill="transparent" />
          {now && slotN(now.aqi) === 'severe' && <circle cx={x} cy={y} r={r + 3} class="severe-ring" />}
          <circle cx={x} cy={y} r={c.ncr ? 6.5 : r} data-aqi={slotN(now?.aqi)} data-aqi-us={slotU(now?.us)} class="map-dot" />
        </a>
      ))}
    </svg>
    {/* Labels are HTML so they stay 11 px at every width. */}
    <div class="pointer-events-none absolute inset-2 sm:inset-4 font-mono text-[11px] text-[var(--color-fg-subtle)]" aria-hidden="true">
      {launch.filter(({ c }) => LABELS[c.slug]).map(({ c, x, y, r }) =>
        LABELS[c.slug] === 'r' ? (
          <span class="absolute whitespace-nowrap" style={`left:${((x + r + 3) / W) * 100}%;top:${(y / H) * 100}%;transform:translateY(-50%)`}>{name(c)}</span>
        ) : (
          <span class="absolute whitespace-nowrap" style={`right:${((W - x + r + 3) / W) * 100}%;top:${(y / H) * 100}%;transform:translateY(-50%)`}>{name(c)}</span>
        ),
      )}
      <span class="absolute whitespace-nowrap" style={`left:${((INSET.cx + INSET.r + 4) / W) * 100}%;top:${(INSET.cy / H) * 100}%;transform:translateY(-50%)`}>{lang === 'hi' ? 'दिल्ली-NCR' : 'Delhi-NCR'}</span>
    </div>
    <div class="map-card raised absolute z-10 w-[220px] p-4 hidden" data-map-card role="status"></div>
    <MapCardLabels lang={lang} link={d.map.view} />
  </div>
  <figcaption class="mt-3">
    <ul class="flex flex-wrap gap-x-3 gap-y-1.5 font-mono text-[11px] text-[var(--color-fg-muted)]" aria-label={d.map.legend}>
      {NAQI_ROWS.map((row, i) => (
        <li class="inline-flex items-center gap-1.5" data-aqi={row.cat}>
          <span class="sq"></span>
          <span class="v-n">{CATEGORY_LABEL[row.cat][lang]} {row.range}</span>
          <span class="v-us">{US_LABEL[US_ROWS[i]!.cat][lang]} {US_ROWS[i]!.range}</span>
        </li>
      ))}
    </ul>
    <p class="t-small text-[var(--color-fg-subtle)] mt-2">{d.home.mapNote} {d.map.attribution}</p>
  </figcaption>
</figure>
<script>
  import '../scripts/mapcards.ts';
</script>
