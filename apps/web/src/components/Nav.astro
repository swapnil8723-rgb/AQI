---
import { t, localePath, type Lang } from '../i18n/index.ts';
import { SITE } from '../lib/site.ts';
import type { SlotName } from '../lib/aqi-ui.ts';

interface Props {
  lang: Lang;
  path: string;
  slot: SlotName;
}
const { lang, path, slot } = Astro.props;
const d = t(lang);
---
<header class="sticky top-0 z-40 h-16 hairline-b backdrop-blur-md" style="background:color-mix(in oklab, var(--color-bg) 80%, transparent)">
  <div class="mx-auto max-w-[1200px] h-full px-4 md:px-6 lg:px-8 flex items-center gap-3">
    <a href={localePath(lang, '/')} class="flex items-center gap-1.5 shrink-0" aria-label={`${SITE.name} — ${d.nav.home}`}>
      <span class="text-[20px] font-semibold tracking-[-0.04em] leading-none">{SITE.name.toLowerCase()}</span>
      {/* The living dot: category colour of the city in view (DESIGN.md §1). */}
      <span class="inline-block size-2 rounded-full translate-y-[3px]" data-aqi={slot} style={slot === 'none' ? 'background:var(--color-fg)' : 'background:var(--aqi-fill)'} data-living-dot></span>
    </a>

    <form action={localePath(lang, '/search')} method="get" role="search" class="hidden lg:flex mx-auto w-[280px] relative" data-search-form>
      <label for="nav-q" class="sr-only">{d.nav.search}</label>
      <input id="nav-q" name="q" class="input pr-10 text-[14px]!" placeholder={d.nav.search} autocomplete="off" data-search-open-on-focus />
      <kbd class="kbd absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none">/</kbd>
    </form>

    <div class="ml-auto lg:ml-0 flex items-center gap-1">
      <button type="button" class="btn btn-ghost px-2.5! lg:hidden" data-search-open aria-label={d.nav.searchShort}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      </button>
      <nav aria-label="Language" class="flex items-center t-small font-medium">
        <a href={localePath('en', path)} hreflang="en" lang="en" class:list={['px-2 py-1 rounded', lang === 'en' ? 'text-[var(--color-fg)]' : 'text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)]']} aria-current={lang === 'en' ? 'true' : undefined} data-lang-link="en">{d.nav.langEn}</a>
        <span class="text-[var(--color-fg-subtle)]" aria-hidden="true">|</span>
        <a href={localePath('hi', path)} hreflang="hi" lang="hi" class:list={['px-2 py-1 rounded deva', lang === 'hi' ? 'text-[var(--color-fg)]' : 'text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)]']} aria-current={lang === 'hi' ? 'true' : undefined} data-lang-link="hi">{d.nav.langHi}</a>
      </nav>
      <button type="button" class="btn btn-ghost px-2.5!" aria-label={d.nav.theme} data-theme-toggle>
        <svg class="dark-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      </button>
    </div>
  </div>
</header>
