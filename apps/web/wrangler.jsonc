/**
 * saans-web — the Astro site (SSR on Workers, assets served free and unmetered).
 * Reads the hourly bundle that saans-ingest writes to KV; never writes data.
 *
 *   npm run build && npx wrangler deploy        (or Workers Builds from GitHub)
 * Paste the same KV namespace id as workers/ingest/wrangler.jsonc.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "saans-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    // Optional: Google AdSense publisher id ("ca-pub-…"). Ad slots render only when set.
    "ADSENSE_CLIENT": "",
    // Optional: Cloudflare Web Analytics token (cookieless).
    "CF_BEACON_TOKEN": ""
  },
  "observability": { "enabled": true }
}
