/**
 * saans-web — the Astro site (SSR on Workers, assets served free and unmetered).
 * Reads the hourly bundle that saans-ingest writes to KV; never writes data.
 *
 *   npm run build && npx wrangler deploy        (or Workers Builds from GitHub)
 * Paste the same KV namespace id as workers/ingest/wrangler.jsonc.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "saans-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // html_handling none: serve public/*.html (the Search Console file) as-is,
  // not 307 to an extensionless URL. Pages are SSR, so nothing else is affected.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none" },
  "kv_namespaces": [{ "binding": "KV", "id": "5c4dcfe8473a4d29a40124f41f85e5fe" }],
  "vars": {
    // Optional: Google AdSense publisher id ("ca-pub-…"). Ad slots render only when set.
    "ADSENSE_CLIENT": "",
    // Optional: Cloudflare Web Analytics token (cookieless).
    "CF_BEACON_TOKEN": "",
    // Optional: Search Console "HTML tag" verification — the content="…" value only.
    // Needed on a *.workers.dev address, where DNS verification is impossible.
    "GOOGLE_SITE_VERIFICATION": ""
  },
  "observability": { "enabled": true }
}
